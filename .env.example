# Copy to .env (pnpm office:install does this for you and fills in a token).
# This file is read by docker-compose.yml and by scripts/install.ts.

# Shared secret the hook sends as `x-office-token`. Auth is skipped when empty
# (fine for a single-user local setup, but office:install generates one).
# office:install also writes this token into ~/.config/tagconn/curl.conf
# (mode 600, read by curl -K so it never appears on a command line/`ps`),
# and into ~/.config/tagconn/attribution.conf (used for .tagconn/office.json imports).
OFFICE_HOOK_TOKEN=

# M8: shared secret between the server and the host runner (apps/runner), used
# only as an HMAC key - never sent on the wire (see docs/design/runner-and-helpdesk.md
# §2.2/§5.2). office:install generates one and writes it into
# ~/.config/tagconn/runner.json (mode 600) too; `runner.*` settings are GUI-immutable.
OFFICE_RUNNER__TOKEN=

# Host ports docker-compose publishes on 127.0.0.1.
OFFICE_PORT=4317
OFFICE_WEB_PORT=4318

# UID/GID the server container runs as, so bind-mounted files (./data,
# ~/.claude/agents) stay owned by you. `id -u` / `id -g` on Linux.
UID=1000
GID=1000

# --- Optional overrides (all have in-code defaults; see config/office.yaml) ---
# Env convention: OFFICE_<SECTION>__<KEY_SNAKE>, applied on top of config/office.yaml.
# Server binds 127.0.0.1 by default outside Docker; docker-compose.yml sets
# OFFICE_SERVER__HOST=0.0.0.0 itself (container-internal only - the published
# port still binds 127.0.0.1 on the host).
# OFFICE_SERVER__HOST=0.0.0.0
# OFFICE_SERVER__PORT=4317
# OFFICE_SERVER__LOG_LEVEL=info
# Accepted Host header hostnames (port ignored); blocks DNS-rebinding. Comma-
# separated list. Server-only setting - never changeable from the GUI.
# OFFICE_SERVER__ALLOWED_HOSTS=localhost,127.0.0.1,[::1],server
# OFFICE_STORAGE__DB_PATH=./data/office.db
# OFFICE_PATHS__AGENTS_DIR=/claude/agents
# OFFICE_PATHS__PROJECTS_DIR=/claude/projects
# OFFICE_CONFIG=./config/office.yaml
# OFFICE_TEMPLATES_DIR=./packages/agent-templates
